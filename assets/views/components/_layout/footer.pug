-
  const footerMenuProjects = [
    { link: '#', name: 'tasktype' },
    { link: '#', name: 'the resale market' },
    { link: '#', name: 'fire duck' },
    { link: '#', name: 'ah365' },
    { link: '#', name: 'schiaparelli' },
    { link: '#', name: 'movie night' },
  ]

  const footerMenuLinks = [
    { link: '#', name: 'my position' },
    { link: '#', name: 'experience' },
    { link: '#', name: 'works' },
  ]

footer.footer
  .footer__wrap
    .footer__cont
      if VIEW !== 'index'
        a.footer__logo(href=getLink('index'))
          img.footer__logo-img(src=staticImg('logo-white.webp'), loading="lazy", alt="Logo")
      else
        .footer__logo
          img.footer__logo-img(src=staticImg('logo-white.webp'), loading="lazy", alt="Logo")
      .footer__area
        .footer__box.footer__box_works
          span.footer__title my work
          .footer__list
            each link, index in footerMenuProjects
              .footer__item
                span.footer__item-numb= index + 1 < 10 ? `0${index + 1}`:index + 1
                a.footer__item-link(href="#")= link.name
        .footer__box
          span.footer__title about me
          .footer__list
            each link in footerMenuLinks
              .footer__item
                a.footer__item-link(href="#")= link.name
        .footer__box
          span.footer__title Contact with me
          .footer__list
            .footer__item
              a.footer__item-link(href=mail1.link, target="_blank" rel="noopener")= mail1.mask
            .footer__item
              a.footer__item-link(href=mail2.link, target="_blank" rel="noopener")= mail2.mask
